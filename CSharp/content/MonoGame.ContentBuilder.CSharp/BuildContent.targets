<Project>
  <!-- Browser static assets resolve during PrepareResources, before BeforeCompile. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'browser-wasm'">
    <PrepareResourcesDependsOn>BuildContent;$(PrepareResourcesDependsOn)</PrepareResourcesDependsOn>
  </PropertyGroup>

  <Target Name="BuildContent" BeforeTargets="BeforeCompile">
    <MSBuild Projects="$(MSBuildThisFileDirectory)MGNamespace.csproj" Targets="Build" RemoveProperties="Configuration;TargetFramework;RuntimeIdentifier;RuntimeIdentifiers">
      <Output TaskParameter="TargetOutputs" ItemName="_ContentBuilderAssembly" />
    </MSBuild>
    <PropertyGroup>
      <ContentOutput>$([MSBuild]::NormalizePath('$(ProjectDir)', '$(OutputPath)').TrimEnd('\/'))</ContentOutput>
      <!-- WebGL2 needs content placed in the wwwroot directory -->
      <ContentOutput Condition="'$(MonoGamePlatform)' == 'WebGL2'">$([MSBuild]::NormalizePath('$(ProjectDir)', 'wwwroot').TrimEnd('\/'))</ContentOutput>
      <ContentTemp>$([MSBuild]::NormalizePath('$(ProjectDir)', '$(IntermediateOutputPath)').TrimEnd('\/'))</ContentTemp>
      <ContentArgs>build -p $(MonoGamePlatform) -s "$(MSBuildThisFileDirectory)Assets" -o "$(ContentOutput)" -i "$(ContentTemp)"</ContentArgs>
      <ContentCommand>@(_ContentBuilderAssembly->'%(RootDir)%(Directory)%(Filename)')</ContentCommand>
    </PropertyGroup>
    <Exec Command="&quot;$(ContentCommand)&quot; $(ContentArgs)" WorkingDirectory="$(MSBuildThisFileDirectory)..\" CustomErrorRegularExpression="\[E\] .+" CustomWarningRegularExpression="\[W\] .+" />
   </Target>
  <Target Name="AddGeneratedContentAssets"
    AfterTargets="BuildContent">
    <ItemGroup>
      <GeneratedAsset Include="$([MSBuild]::NormalizePath('$(ProjectDir)', '$(OutputPath)'))Content\**\*"
        Condition="'$(MonoGamePlatform)' != 'WebGL2'" />
      <GeneratedAsset Include="$(ContentOutput)\Content\**\*"
        Condition="'$(MonoGamePlatform)' == 'WebGL2'" />

      <!-- Post Process Android Assets -->
      <AndroidAsset Include="@(GeneratedAsset)"
        Condition="'$(MonoGamePlatform)' == 'Android'">
        <Link>Content\%(GeneratedAsset.RecursiveDir)%(GeneratedAsset.Filename)%(GeneratedAsset.Extension)</Link>
      </AndroidAsset>

      <!-- Post Process iOS Bundle Resources -->
      <BundleResource Include="@(GeneratedAsset)"
        Condition="'$(MonoGamePlatform)' == 'iOS'">
        <Link>Content\%(GeneratedAsset.RecursiveDir)%(GeneratedAsset.Filename)%(GeneratedAsset.Extension)</Link>
      </BundleResource>

      <!-- Copy content for `dotnet publish` builds -->
      <ContentWithTargetPath Include="@(GeneratedAsset)"
        Condition="'$(MonoGamePlatform)' != 'Android' And '$(MonoGamePlatform)' != 'iOS' And '$(MonoGamePlatform)' != 'WebGL2'">
        <TargetPath>Content\%(GeneratedAsset.RecursiveDir)%(GeneratedAsset.Filename)%(GeneratedAsset.Extension)</TargetPath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ContentWithTargetPath>

      <!-- 
          WebGL2:
          On the first content build, generated assets do not yet exist in wwwroot.
          On subsequent builds, assets from the previous build are implicitly included by the Web SDK.
          Replace those items so Static Web Assets sees each generated asset once.
      -->
      <Content Remove="@(GeneratedAsset->'wwwroot\Content\%(RecursiveDir)%(Filename)%(Extension)')"
        Condition="'$(MonoGamePlatform)' == 'WebGL2'" />
      <Content Include="@(GeneratedAsset->'wwwroot\Content\%(RecursiveDir)%(Filename)%(Extension)')"
        Condition="'$(MonoGamePlatform)' == 'WebGL2'">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>
  </Target>
</Project>
