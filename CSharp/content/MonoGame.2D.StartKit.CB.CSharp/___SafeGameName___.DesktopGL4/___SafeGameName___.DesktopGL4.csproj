        <PackageReference Include="MonoGame.Runtime.Windows.DesktopGL4" Version="3.8.6" />
        <PackageReference Include="MonoGame.Runtime.Linux.DesktopGL4" Version="3.8.6" />
        <PackageReference Include="MonoGame.Runtime.Mac.DesktopGL4" Version="3.8.6" />
    </ItemGroup>
    <Import Project="..\___SafeGameName___.Content\BuildContent.targets" />
</Project>
